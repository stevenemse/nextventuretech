# ============================================================
# NextVenture Tech — Variables d'environnement
# Copier ce fichier en .env.local et remplir les valeurs
# ⚠️  Ne jamais committer .env.local (déjà dans .gitignore)
# ============================================================

# ─── Supabase (public) ──────────────────────────────────────
# Obtenir sur : https://app.supabase.com → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ─── Supabase (serveur uniquement) ──────────────────────────
# ⚠️  NE JAMAIS exposer cette clé côté navigateur
# Obtenir sur : Project Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── App ────────────────────────────────────────────────────
# URL de base du site (sans slash final)
# Développement : http://localhost:3000
# Production : https://votre-domaine.vercel.app
NEXT_PUBLIC_SITE_URL=https://your-domain.vercel.app
